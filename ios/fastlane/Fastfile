default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight using App Store Connect API"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]&.strip
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]&.strip
    key_base64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]&.strip

    UI.user_error!("APP_STORE_CONNECT_KEY_ID secret is missing!") if key_id.nil? || key_id.empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID secret is missing!") if issuer_id.nil? || issuer_id.empty?
    UI.user_error!("APP_STORE_CONNECT_API_KEY_BASE64 secret is missing!") if key_base64.nil? || key_base64.empty?

    # Normalizzazione chiave PEM
    raw_key = key_base64
    if !raw_key.include?("-----BEGIN")
      decoded = Base64.decode64(raw_key)
      raw_key = decoded.include?("-----BEGIN") ? decoded : "-----BEGIN PRIVATE KEY-----\n" + raw_key.scan(/.{1,64}/).join("\n") + "\n-----END PRIVATE KEY-----"
    end
    raw_key = raw_key.gsub('\n', "\n").strip

    key_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(key_dir)
    key_filepath = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_filepath, raw_key + "\n")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath,
      in_house: false
    )

    bundle_id = "com.rossofuoco.personale"
    app_name = "RossoFuoco Personale"

    # 1. Genera Xcode Project
    sh("cd ../.. && xcodegen generate")

    # 2. Configura Keychain temporaneo per la firma
    keychain_name = "fastlane_keychain"
    keychain_password = "rossofuoco_temp_pass"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # 3. Assicura che l'App Identifier esista nel Developer Portal
    app_identifier = Spaceship::ConnectAPI::BundleId.find(bundle_id)
    if app_identifier.nil?
      UI.message("Creating App Identifier #{bundle_id} on Apple Developer portal...")
      app_identifier = Spaceship::ConnectAPI::BundleId.create(
        identifier: bundle_id,
        name: app_name,
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS
      )
      UI.success("App Identifier #{bundle_id} created successfully!")
    else
      UI.message("App Identifier #{bundle_id} already exists on Apple Developer portal.")
    end

    # 4. Assicura che l'App esista su App Store Connect
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    if app.nil?
      UI.message("Creating App #{app_name} on App Store Connect...")
      Spaceship::ConnectAPI::App.create(
        bundle_id: bundle_id,
        name: app_name,
        locale: "it-IT",
        sku: "rossofuoco-pers-#{Time.now.to_i}",
        primary_locale: "it-IT"
      )
      UI.success("App created on App Store Connect!")
    else
      UI.message("App already exists on App Store Connect.")
    end

    # 5. Ottieni o genera certificato di distribuzione iOS
    get_certificates(
      api_key: api_key,
      development: false,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    )

    # 6. Ottieni o genera provisioning profile App Store per iOS
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_id
    )

    # 7. Compila e firma l'app in formato .ipa
    build_app(
      project: "RossoFuoco.xcodeproj",
      scheme: "RossoFuoco",
      export_method: "app-store",
      clean: true,
      output_directory: "./build-output"
    )

    # 8. Carica direttamente su TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
