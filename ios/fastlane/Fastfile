default_platform(:ios)

platform :ios do
  desc "Automated native build and deploy to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]&.strip
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]&.strip
    key_base64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]&.strip

    UI.user_error!("APP_STORE_CONNECT_KEY_ID secret is missing!") if key_id.nil? || key_id.empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID secret is missing!") if issuer_id.nil? || issuer_id.empty?
    UI.user_error!("APP_STORE_CONNECT_API_KEY_BASE64 secret is missing!") if key_base64.nil? || key_base64.empty?

    # Normalizzazione chiave API App Store Connect
    raw_key = key_base64
    if !raw_key.include?("-----BEGIN")
      decoded = Base64.decode64(raw_key)
      raw_key = decoded.include?("-----BEGIN") ? decoded : "-----BEGIN PRIVATE KEY-----\n" + raw_key.scan(/.{1,64}/).join("\n") + "\n-----END PRIVATE KEY-----"
    end
    raw_key = raw_key.gsub('\n', "\n").strip

    key_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(key_dir)
    key_filepath = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_filepath, raw_key + "\n")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath,
      in_house: false
    )

    bundle_id = "com.rossofuoco.personale"
    app_title = "RossoFuoco"

    # Incremento dinamico della build da TestFlight
    latest_build = nil
    begin
      latest_build = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: bundle_id,
        version: "1.0.0"
      )
    rescue => tf_err
      UI.important("Could not fetch latest TestFlight build number: #{tf_err.message}")
    end

    github_run = ENV["GITHUB_RUN_NUMBER"]&.to_i || 0
    # Assicura un numero di build superiore a tutte le precedenti (es. 56+)
    next_build_number = [(latest_build.to_i + 1), (github_run > 0 ? (github_run + 10) : 56), 56].max
    UI.message("Resolved Next CFBundleVersion / Build Number: #{next_build_number} (Latest on TestFlight: #{latest_build.inspect})")

    # Aggiorna plist nativo prima della compilazione Xcode
    [
      File.expand_path("../Info.plist"),
      File.expand_path("Info.plist"),
      File.expand_path("../ios/Info.plist"),
      File.expand_path("../../ios/Info.plist"),
      "Info.plist",
      "ios/Info.plist"
    ].each do |plist_file|
      if File.exist?(plist_file)
        UI.message("Updating CFBundleVersion in #{plist_file} to #{next_build_number}")
        system("/usr/libexec/PlistBuddy -c 'Set :CFBundleVersion #{next_build_number}' '#{plist_file}'") rescue nil
        system("/usr/libexec/PlistBuddy -c 'Set :ITSAppUsesNonExemptEncryption false' '#{plist_file}'") rescue nil
      end
    end

    # 1. Configura Keychain temporaneo per la firma
    keychain_name = "fastlane_keychain"
    keychain_password = "rossofuoco_secure_keychain_pass"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )
    keychain_db = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    # 2. Ottieni o crea certificato di distribuzione (senza revocare certificati validi a ogni esecuzione)
    begin
      get_certificates(
        api_key: api_key,
        development: false,
        keychain_path: keychain_db,
        keychain_password: keychain_password,
        force: false
      )
    rescue => cert_err
      UI.important("Certificate retrieval notice: #{cert_err.message}. Attempting renewal if limit reached...")
      # Se il limite massimo di certificati è raggiunto, rimuovi solo il più vecchio per fare spazio
      begin
        certs = Spaceship::ConnectAPI::Certificate.all
        dist_certs = certs.select { |c| c.certificate_type.to_s.downcase.include?("distribution") || c.certificate_type.to_s.downcase.include?("ios_dist") }
        if dist_certs.count >= 2
          oldest_cert = dist_certs.first
          UI.message("Apple cert limit reached. Removing oldest certificate #{oldest_cert.id}...")
          oldest_cert.delete!
        end
      rescue => clean_err
        UI.important("Could not clean old cert: #{clean_err.message}")
      end

      get_certificates(
        api_key: api_key,
        development: false,
        keychain_path: keychain_db,
        keychain_password: keychain_password,
        force: true
      )
    end

    # 3. Assicura che l'app sia registrata su App Store Connect
    begin
      produce(
        api_key: api_key,
        app_identifier: bundle_id,
        app_name: app_title,
        language: "Italian",
        skip_itc: false
      )
    rescue => produce_err
      UI.message("App ID check: #{produce_err.message}")
    end

    # 4. Ottieni provisioning profile App Store per iOS
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_id,
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] || ENV["SIGH_NAME"]
    profile_uuid = lane_context[SharedValues::SIGH_UUID] || ENV["SIGH_UUID"]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH] || ENV["SIGH_PROFILE_PATH"]

    team_id = nil
    if profile_path && File.exist?(profile_path)
      plist_data = `security cms -D -i "#{profile_path}" 2>/dev/null`
      if plist_data =~ /<key>TeamIdentifier<\/key>\s*<array>\s*<string>([^<]+)<\/string>/m
        team_id = $1.strip
      end
    end

    UI.message("Using profile: #{profile_name} (UUID: #{profile_uuid}) Team: #{team_id}")

    # 6. Aggiorna configurazione Code Signing del progetto Xcode
    update_code_signing_settings(
      path: "../RossoFuoco.xcodeproj",
      use_automatic_signing: false,
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      team_id: team_id
    )

    if team_id && !team_id.empty?
      update_project_team(
        path: "../RossoFuoco.xcodeproj",
        teamid: team_id
      )
    end

    begin
      increment_build_number(
        xcodeproj: "../RossoFuoco.xcodeproj",
        build_number: next_build_number.to_s
      )
    rescue => inc_err
      UI.important("Notice increment_build_number: #{inc_err.message}")
    end

    # 7. Compila e firma l'app nativa con Xcode
    xcargs_params = [
      "CODE_SIGN_STYLE=Manual",
      "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
      "PROVISIONING_PROFILE='#{profile_uuid}'",
      "CODE_SIGN_IDENTITY='Apple Distribution'",
      "CURRENT_PROJECT_VERSION=#{next_build_number}",
      "INFOPLIST_KEY_UIRequiresFullScreen=YES"
    ]
    xcargs_params << "DEVELOPMENT_TEAM='#{team_id}'" if team_id && !team_id.empty?

    output_dir = File.expand_path("../build-output")
    FileUtils.mkdir_p(output_dir)

    build_app(
      project: "../RossoFuoco.xcodeproj",
      scheme: "RossoFuoco",
      export_method: "app-store",
      clean: true,
      output_directory: output_dir,
      output_name: "RossoFuoco.ipa",
      export_options: {
        provisioningProfiles: {
          bundle_id => profile_name
        }
      },
      xcargs: xcargs_params.join(" ")
    )

    actual_ipa_path = File.join(output_dir, "RossoFuoco.ipa")
    UI.message("Native build complete. Package: #{actual_ipa_path}")

    # 8. Carica su TestFlight
    UI.message("Uploading pure native IPA package to TestFlight: #{actual_ipa_path}")
    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      ipa: actual_ipa_path,
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption: false
    )
  end
end
