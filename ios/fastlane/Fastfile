default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight using App Store Connect API"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_base64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_base64,
      is_key_content_base64: true,
      in_house: false
    )

    # 1. Crea App se non esiste su App Store Connect
    produce(
      api_key: api_key,
      app_identifier: "com.rossofuoco.personale",
      app_name: "RossoFuoco Personale",
      language: "Italian",
      app_version: "1.0.0",
      sku: "rossofuoco-personale-1"
    ) rescue UI.message("App already exists on App Store Connect")

    # 2. Ottieni o genera certificato di distribuzione
    get_certificates(
      api_key: api_key,
      type: "distribution"
    )

    # 3. Ottieni o genera provisioning profile App Store
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.rossofuoco.personale",
      type: "app-store"
    )

    # 4. Genera Xcode Project da XcodeGen
    sh("cd ../.. && xcodegen generate")

    # 5. Compila e firma l'app in formato .ipa
    build_app(
      project: "RossoFuoco.xcodeproj",
      scheme: "RossoFuoco",
      export_method: "app-store",
      clean: true,
      output_directory: "./build-output"
    )

    # 6. Carica direttamente su TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
