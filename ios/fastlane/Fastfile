default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight using App Store Connect API"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]&.strip
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]&.strip
    key_base64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]&.strip

    UI.user_error!("APP_STORE_CONNECT_KEY_ID secret is missing!") if key_id.nil? || key_id.empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID secret is missing!") if issuer_id.nil? || issuer_id.empty?
    UI.user_error!("APP_STORE_CONNECT_API_KEY_BASE64 secret is missing!") if key_base64.nil? || key_base64.empty?

    # Normalizzazione chiave PEM
    raw_key = key_base64
    if !raw_key.include?("-----BEGIN")
      decoded = Base64.decode64(raw_key)
      raw_key = decoded.include?("-----BEGIN") ? decoded : "-----BEGIN PRIVATE KEY-----\n" + raw_key.scan(/.{1,64}/).join("\n") + "\n-----END PRIVATE KEY-----"
    end
    raw_key = raw_key.gsub('\n', "\n").strip

    key_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(key_dir)
    key_filepath = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_filepath, raw_key + "\n")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath,
      in_house: false
    )

    bundle_id = "com.rossofuoco.personale"
    app_name = "RossoFuoco Personale"

    # 1. Configura Keychain temporaneo per la firma
    keychain_name = "fastlane_keychain"
    keychain_password = "rossofuoco_temp_pass"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # 2. Pulizia preventiva di TUTTI i vecchi certificati di distribuzione senza chiave privata locale per garantire slot libero
    keychain_db = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    begin
      certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = certs.select { |c| c.certificate_type.to_s.downcase.include?("distribution") || c.certificate_type.to_s.downcase.include?("ios_dist") }
      UI.message("Found #{dist_certs.count} existing Distribution certificates in Apple Developer account.")
      dist_certs.each do |c|
        UI.message("Revoking orphan certificate: #{c.id} (#{c.name}) to ensure a fresh clean slot...")
        begin
          c.delete!
        rescue => del_err
          UI.important("Could not delete cert #{c.id}: #{del_err.message}")
        end
      end
    rescue => list_err
      UI.important("Certificate inspection notice: #{list_err.message}")
    end

    # 3. Genera nuovo certificato di distribuzione con chiave privata nel portachiavi locale
    get_certificates(
      api_key: api_key,
      development: false,
      keychain_path: keychain_db,
      keychain_password: keychain_password,
      force: true
    )

    # 4. Ottieni o genera provisioning profile App Store per iOS
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_id,
      force: true
    )

    # 5. Genera Xcode Project nella directory corretta
    sh("cd .. && xcodegen generate")

    # 6. Compila e firma l'app in formato .ipa
    build_app(
      project: "../RossoFuoco.xcodeproj",
      scheme: "RossoFuoco",
      export_method: "app-store",
      clean: true,
      output_directory: "../build-output"
    )

    # 7. Carica direttamente su TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
